# qkern .env.example: copy to .env (git-ignored). This project needs NO secrets.
# Publishing uses PyPI Trusted Publishing (OIDC). Never put PyPI/TestPyPI tokens here
# or in GitHub secrets.

# Optional. Local data root inside the WSL ext4 filesystem (never /mnt/*); the repo's data/ is a symlink to it.
DATA_ROOT=~/data/quant-cpp-python-bindings
# Optional. Root folder holding canonical Parquet from sibling repos
# (data/<dataset>/venue=<v>/symbol=<s>/date=YYYY-MM-DD/part-*.parquet). Empty = skip real-workload benchmarks.
QKERN_REAL_DATA_DIR=
# Optional. Output directory for benchmark JSON and the run log. Default: results/bench
QKERN_BENCH_OUT=results/bench
# Optional. Max threads for the thread-scaling benchmark. Default: physical cores, capped at 8.
QKERN_BENCH_MAX_THREADS=
# Optional. Machine label shown in benchmark reports. Default: hostname.
QKERN_BENCH_HOST_LABEL=
# Optional. Hypothesis profile: dev (100 examples), ci (500), nightly (5000). Default: dev.
HYPOTHESIS_PROFILE=dev
# Optional. Standard CMake variable: parallel build jobs. Default: number of cores.
CMAKE_BUILD_PARALLEL_LEVEL=8
